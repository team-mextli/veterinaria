@page "{id:int}"
@model Veterinaria.Web.Pages.Clientes.DetalleModel
@{
    ViewData["Title"] = "Detalle del Cliente";
}

<div class="page-header">
    <h1><i class="ti ti-user-circle"></i>Detalle del Cliente</h1>
</div>

<div class="soft-card">
    <div class="d-flex align-items-center gap-3 mb-3">
        <div class="avatar lg av-0">
            @Model.Cliente.Nombre[..1]@Model.Cliente.ApellidoPaterno[..1]
        </div>
        <div>
            <div class="fs-4 fw-medium">
                @Model.Cliente.Nombre @Model.Cliente.ApellidoPaterno @Model.Cliente.ApellidoMaterno
            </div>
            <span class="badge-soft coral"><i class="ti ti-user"></i> Propietario</span>
        </div>
    </div>

    <ul class="info-list">
        <li>
            <i class="ti ti-phone"></i>
            <div><small>Teléfono</small>@Model.Cliente.Telefono</div>
        </li>
        <li>
            <i class="ti ti-mail"></i>
            <div><small>Correo</small>@Model.Cliente.Correo</div>
        </li>
        <li>
            <i class="ti ti-map-pin"></i>
            <div><small>Dirección</small>@Model.Cliente.Direccion</div>
        </li>
    </ul>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="soft-alert warn">
            <i class="ti ti-alert-triangle me-1"></i>@Model.Error
        </div>
    }

    <h2 class="h4 mt-4">Mascotas</h2>

    @if (Model.Mascotas.Count == 0)
    {
        <div class="soft-alert warn">
            <i class="ti ti-mood-empty me-1"></i>
            Este cliente todavía no tiene mascotas registradas.
        </div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mascota in Model.Mascotas)
                    {
                        <tr>
                            <td>@mascota.Nombre</td>
                            <td>@mascota.Especie</td>
                            <td>@mascota.Raza</td>
                            <td>
                                <a asp-page="/Mascotas/Detalle"
                                   asp-route-id="@mascota.IdMascota"
                                   class="btn btn-sm btn-outline-primary">
                                    Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="d-flex flex-wrap gap-2">
        <a asp-page="/Mascotas/Index" asp-route-idCliente="@Model.Cliente.IdCliente"
           class="btn btn-success">
            <i class="ti ti-paw"></i> Ver Mascotas
        </a>
        <a asp-page="./Editar" asp-route-id="@Model.Cliente.IdCliente"
           class="btn btn-primary">
            <i class="ti ti-pencil"></i> Editar
        </a>
        <a asp-page="./Index" class="btn btn-secondary">
            <i class="ti ti-arrow-left"></i> Regresar
        </a>
    </div>
</div>
