@page "{id:int}"
@model Veterinaria.Web.Pages.Mascotas.DetalleModel
@{
    ViewData["Title"] = "Detalle de Mascota";
    var perro = Model.Mascota.Especie.Equals("Perro", StringComparison.OrdinalIgnoreCase);
    var gato = Model.Mascota.Especie.Equals("Gato", StringComparison.OrdinalIgnoreCase);
    var icono = perro ? "ti-dog" : gato ? "ti-cat" : "ti-paw";
    var color = perro ? "av-0" : gato ? "av-1" : "av-2";
    var hembra = Model.Mascota.Sexo == "Hembra";
}

<div class="page-header">
    <h1><i class="ti ti-paw"></i>Detalle de Mascota</h1>
</div>

<div class="soft-card">
    <div class="d-flex align-items-center gap-3 mb-3">
        <div class="avatar lg @color"><i class="ti @icono"></i></div>
        <div>
            <div class="fs-4 fw-medium">@Model.Mascota.Nombre</div>
            <span class="badge-soft @(hembra ? "sun" : "coral")">
                <i class="ti @(hembra ? "ti-gender-female" : "ti-gender-male")"></i>
                @Model.Mascota.Sexo
            </span>
        </div>
    </div>

    <ul class="info-list">
        <li>
            <i class="ti ti-user"></i>
            <div><small>Propietario</small>@Model.Propietario</div>
        </li>
        <li>
            <i class="ti ti-paw"></i>
            <div><small>Especie</small>@Model.Mascota.Especie</div>
        </li>
        <li>
            <i class="ti ti-tag"></i>
            <div><small>Raza</small>@Model.Mascota.Raza</div>
        </li>
    </ul>

    <div class="d-flex flex-wrap gap-2">
        <a asp-page="./Editar" asp-route-id="@Model.Mascota.IdMascota"
           class="btn btn-primary">
            <i class="ti ti-pencil"></i> Editar
        </a>
        <a asp-page="./Index" class="btn btn-secondary">
            <i class="ti ti-arrow-left"></i> Regresar
        </a>
    </div>
</div>
