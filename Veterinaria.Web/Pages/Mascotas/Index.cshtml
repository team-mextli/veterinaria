@page
@model Veterinaria.Web.Pages.Mascotas.IndexModel
@{
    ViewData["Title"] = "Mascotas";
    string esp = Model.Especie ?? "";
}

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="soft-alert ok">
        <i class="ti ti-circle-check me-1"></i>@mensaje
    </div>
}

<div class="page-header">
    <div>
        <h1><i class="ti ti-paw"></i>Mascotas</h1>
        <p class="page-sub">Mascotas registradas.</p>
    </div>

    <a asp-page="./Nueva" class="btn btn-primary">
        <i class="ti ti-plus"></i> Nueva mascota
    </a>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-page="./Index" asp-route-idCliente="@Model.IdCliente"
       class="chip @(esp == "" ? "on" : "")">Todas</a>
    <a asp-page="./Index" asp-route-idCliente="@Model.IdCliente" asp-route-especie="Perro"
       class="chip @(esp == "Perro" ? "on" : "")">Perros</a>
    <a asp-page="./Index" asp-route-idCliente="@Model.IdCliente" asp-route-especie="Gato"
       class="chip @(esp == "Gato" ? "on" : "")">Gatos</a>
</div>

@if (!Model.Mascotas.Any())
{
    <div class="soft-alert warn">
        <i class="ti ti-mood-empty me-1"></i>
        No hay mascotas para mostrar con este filtro.
    </div>
}

<div class="pet-grid">
@foreach (var item in Model.Mascotas)
{
    var perro = item.Mascota.Especie.Equals("Perro", StringComparison.OrdinalIgnoreCase);
    var gato = item.Mascota.Especie.Equals("Gato", StringComparison.OrdinalIgnoreCase);
    var icono = perro ? "ti-dog" : gato ? "ti-cat" : "ti-paw";
    var color = perro ? "av-0" : gato ? "av-1" : "av-2";
    var hembra = item.Mascota.Sexo == "Hembra";

    <div class="pet-card">
        <div class="avatar @color"><i class="ti @icono"></i></div>
        <div class="pet-name">@item.Mascota.Nombre</div>
        <div class="pet-breed">@item.Mascota.Especie · @item.Mascota.Raza</div>

        <span class="badge-soft @(hembra ? "sun" : "coral")">
            <i class="ti @(hembra ? "ti-gender-female" : "ti-gender-male")"></i>
            @item.Mascota.Sexo
        </span>

        <div class="pet-owner"><i class="ti ti-user"></i> @item.Propietario</div>

        <a asp-page="./Detalle" asp-route-id="@item.Mascota.IdMascota"
           class="btn btn-sm btn-outline-primary">
            <i class="ti ti-eye"></i> Ver
        </a>
        <a asp-page="./Editar" asp-route-id="@item.Mascota.IdMascota"
           class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-pencil"></i> Editar
        </a>
    </div>
}
</div>
