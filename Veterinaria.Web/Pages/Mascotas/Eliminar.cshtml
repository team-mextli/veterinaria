@page "{id:int}"
@model Veterinaria.Web.Pages.Mascotas.EliminarModel
@{
    ViewData["Title"] = "Eliminar Mascota";
}

<div class="page-header">
    <h1><i class="ti ti-trash"></i>Eliminar Mascota</h1>
</div>

<div class="soft-card">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="soft-alert warn">
            <i class="ti ti-alert-triangle me-1"></i>@Model.Error
        </div>

        <a asp-page="./Index" class="btn btn-secondary">
            <i class="ti ti-arrow-left"></i> Regresar
        </a>
    }
    else
    {
        <div class="soft-alert warn">
            ¿Desea eliminar a
            <strong>@Model.Mascota.Nombre</strong>?
        </div>

        <p>
            Propietario:
            <strong>
                @Model.Propietario.Nombre
                @Model.Propietario.ApellidoPaterno
            </strong>
        </p>

        <form method="post" class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="ti ti-trash"></i> Eliminar
            </button>

            <a asp-page="./Index" class="btn btn-secondary">
                Cancelar
            </a>
        </form>
    }
</div>